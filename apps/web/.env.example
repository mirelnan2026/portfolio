# Copy to .env.local (git-ignored). On Vercel, set the same names in Project Settings → Environment Variables.
# Neon: the read-only role from `pnpm --filter @mirelnan/db db:reader` (packages/db/.env.reader.local),
# pooled host (`-pooler` in the hostname), with sslmode=verify-full. Never the owner role.
DATABASE_URL=postgresql://portfolio_reader:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full
# Upstash Redis (rate limiting), REST API tab of the database in console.upstash.com. The standard token,
# not the read-only one: the limiter writes. Read on the first API request, never at build.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>
# Claude API key, on Vercel as a Sensitive variable (Production and Preview).
ANTHROPIC_API_KEY=
# Signs the chat's assistant turns (HMAC-SHA256, ADR 0010): 32 random bytes, base64url without padding.
# Production and Preview get different keys (Sensitive on Vercel). A new key invalidates every open conversation.
CHAT_SIGNING_KEY=
# Shows the chat ("Ask about me") when "true". Read at build: on Vercel, set it for Preview only until launch.
CHAT_ENABLED=
