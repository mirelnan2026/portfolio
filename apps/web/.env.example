# Copy to .env.local (git-ignored). On Vercel, set the same names in Project Settings → Environment Variables.
# Neon: the read-only role from `pnpm --filter @mirelnan/db db:reader` (packages/db/.env.reader.local),
# pooled host (`-pooler` in the hostname), with sslmode=verify-full. Never the owner role.
DATABASE_URL=postgresql://portfolio_reader:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full
