{
  "name": "@mirelnan/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/cli/seed.ts",
    "db:reader": "tsx --env-file-if-exists=.env.local src/cli/create-reader.ts"
  },
  "dependencies": {
    "@mirelnan/cv-data": "workspace:*",
    "@mirelnan/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@mirelnan/eslint-config": "workspace:*",
    "@mirelnan/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
